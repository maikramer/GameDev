<!--
  Migrated from VibeGame by scripts/migrate_from_vibegame.py; tags não
  implementadas passam verbatim e fazem no-op na engine.
  Dropped attrs: corner-radius, edge-feather, edge-noise, normal-map-url, place:align-to-terrain, texture-scale, texture-url
-->
<world>
  <!--
  Discordia district fragment. Loaded via Include from cities/discordia.xml.
  Artérias cobble → paths/network.xml (<RoadNetwork>). Aqui: só pad da praça.
  Layout compacto: praça 32×32 → 20×20 (muralha ±39.8). Continua a ser a maior
  área aberta da cidade — o que encolheu foi o vazio entre distritos.
-->
  <Group name="city.roads" translation="0 0 0">
    <!-- Chão da praça. Era um <Plane> 20x20: um quadrado a y=0.05 fixo, de
         cantos duros, empilhado por cima do disco de junção que a rede de
         estradas também põe em 0 0 — dois decals de cobblestone quase à
         mesma altura, a brigar no depth e a somar feathers. Agora é um
         <GroundDecal>: drapeja no terreno, a borda ondula e desvanece em
         alpha até zero, e o disco de junção é suprimido por baixo dele
         (features.rs). texture-scale=9 = o mesmo divisor das ribbons, por
         isso o cobble bate exactamente na junção com as artérias. -->
    <GroundDecal name="city.plaza.floor" at="0 0" radius="10.5" feather="3.5" noise="0.09"
                 texture="/assets/textures/cobblestone_road/albedo.ktx2" texture-scale="9"
                 base-color="#9d9891" roughness="0.9" />
  </Group>
</world>
