<!-- ============================================================
     qa-juice — mundo MÍNIMO para QA visual do passe de juice r1:
     chuva com ciclo + partículas soft + lanterna noturna,
     nametags (NPC "!"/hostil vermelho), anel de alvo, hit-react,
     números de dano (Cinzel+pop), vinheta de HP baixo, level-up.

       Usar a sessão partilhada de QA: viber session up (world=este ficheiro).
     ============================================================ -->
<world clear-color="#1b2432">

  <Sky />
  <DayCycle minute-of-day="1380" minutes-per-real-second="1" />
  <AmbientLight brightness="0.7" />
  <Weather wind="0.7 0.25" wind-strength="1.5" clouds="0.8" rain="1" cycle="1" />

  <Terrain world-size="256" max-height="14" seed="11" />
  <DirectionalLight illuminance="28000" shadows="1" direction="-0.4 -0.8 -0.3" />

  <BiomeRegion id="qa-vale" display-name="Vale do QA" polygon="[-160,-160;160,-160;160,160;-160,160]" fog-density="0.0020" />

  <PlayerGLTF model-url="/assets/meshes/characters/hero_lod0.glb" pos="0 3 0" />
  <ThirdPersonCamera target="player" distance="7" pitch="22" />

  <!-- NPC de quest: nametag + "!" + prompt [E] -->
  <Entity name="npc_qa" translation="4 0 -6">
    <GltfScene url="/assets/meshes/characters/npc_guard_lod0.glb" />
    <DialogueNPC dialogue-id="forest_wolves" marker-height="2.5" />
  </Entity>

  <!-- Hostis sem script (IA da engine): nametag vermelha, anel de alvo [V],
       hit-react/números de dano com [J], corpse fade -->
  <DynamicSpawner count="4" seed="5" region-min="-14 0 -14" region-max="14 0 14">
    <Creature role="enemy" script="enemies/goblin.lua">
      <GltfScene url="/assets/meshes/characters/goblin_lod0.glb" />
    </Creature>
  </DynamicSpawner>

  <HudScreenLayer />
  <Minimap range="60" />
  <WaypointArrow />
  <DialogueBalloon />

  <Include src="/world/hud.xml" />
</world>
