<!--
  Terrain feature demo. Exercises every declarative ground feature of the
  Viber native terrain: heightfield, pads, lake, river, cliffs, roads and a
  road network with a bridge segment. "cargo run: analyze worlds/terrain.xml"
  must report 1 heightfield + ground features (incl. 3 cliffs) and no skipped
  tags.
-->
<world clear-color="#87ceeb">
  <!-- QA de cliffs: cópia do terrain.xml + um elemento de HUD
       (insere HudAssets, contorno temporário de um panic alheio em
       ui::widgets::drive_ui_tooltip em mundos sem UI). -->
  <Compass />
  <AmbientLight color="#bfd4e0" brightness="400" />
  <DirectionalLight direction="-0.5 -1 -0.3" illuminance="28000" shadows="true" />

  <!-- Heightfield: procedural (no heightmap attribute), 512 m world.
       `layers` liga o blend das 12 texturas de solo do pool (substitui o
       tint por altura) — inclui areia no fundo do lago/rio e nas margens.
       `cliff-angle` é o gatilho de parede (LOD peak-preserving + triplanar
       do shader); `sharpen` terraceia rampas > sharpen-angle no campo final. -->
  <Terrain name="vale" world-size="512" max-height="60" chunk-size="64"
           levels="4" resolution="64" collision-resolution="32"
           height-smoothing="1" seed="7"
           base-color="#c9c5ba"
           layers="grass vale_grass dirt dirt_trail forest_floor gravel mountain_stone sand desert_sand snow_peak swamp_mud dirt_road"
           shore-width="5" snow-height="0.92"
           cliff-angle="50" sharpen="true" sharpen-angle="38" sharpen-seed="7"
           cliff-streaks="0.55" cliff-moss="0.4" />

  <!-- Cliffs de demonstração: uma escarpa concave no quadrante NW (parede
       de pedreira virada a sul, com cone de detritos), uma muralha vertical
       a leste com ravinas de erosão e uma banda terraced no norte com colos
       no creste. Auto height em todas — a parede adapta-se à diferença
       natural do lugar. -->
  <Cliff name="escarpa_nw" path="-180 -40 -120 -60 -70 -50"
         width="10" profile="concave" side="auto" noise="0.25" seed="3"
         talus="1" />
  <Cliff name="muralha_e" path="220 60 220 -60"
         width="6" height="22" angle="72" profile="vertical" side="left" noise="0.1" seed="11"
         gullies="0.3" />
  <Cliff name="terracas_n" path="-60 200 40 190 120 205"
         width="14" profile="terraced" side="auto" noise="0.3" seed="23"
         notches="0.15" />

  <!-- Plaza pad at the world center. -->
  <TerrainPad name="plaza" at="0 0" size="48 48" falloff="14" corner-radius="10" />

  <!-- Lake in the southwest quadrant. -->
  <Lake name="lagoa" at="-140 -120" radius="26" depth="3.2" water-offset="0.6"
        color="#2f5a4a" opacity="0.62" ripple="0.5" />

  <!-- River crossing the map from north to south, through the east side. -->
  <River name="rio" path="150 220 170 120 150 20 175 -80 150 -200"
         width="14" depth="3.4" water-offset="1.0"
         bank-width="5.5" bank-height="0.9" color="#2a6685" opacity="0.72" />

  <!-- A dirt trail (decal only — no terrain carve). -->
  <Road name="trilha" path="-60 32 -10 24 40 30"
        width="3" flatten="0" texture-scale="6" edge-feather="1.0" />

  <!-- Road network: plaza crossings + a bridge over the river. -->
  <RoadNetwork name="estradas" default-profile="artery" default-width="6"
               crossing-flare="true" flatten="true"
               flatten-falloff="18" flatten-window="56" flatten-max-grade="0.3"
               texture-scale="9">
    <Way id="plaza" xz="0 0" width="8" />
    <Way id="oeste" xz="-60 0" />
    <Way id="nascente" xz="120 0" />
    <Way id="ponte_o" xz="128 0" />
    <Way id="ponte_e" xz="160 0" />
    <Way id="leste" xz="190 0" />

    <Segment a="plaza" b="oeste" />
    <Segment a="plaza" b="nascente" />
    <!-- Bridge: spans the river channel; no corridor carve. -->
    <Segment a="ponte_o" b="ponte_e" profile="bridge" />
    <Segment a="ponte_e" b="leste" />
  </RoadNetwork>

  <OrbitCamera target="plaza" distance="55" height="16" pitch="18" />
</world>
